---
import { withBase } from '../utils/url';
import Icon from '../components/Icon.astro';
import { profile, projects } from '../data/portfolio';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Overview', description = profile.introduction } = Astro.props;
const isHome = Astro.url.pathname.replace(/\/$/, '') === withBase('/').replace(/\/$/, '');
const navigation = [
  { label: 'Overview', id: 'overview', icon: 'home' },
  { label: 'Certifications', id: 'certifications', icon: 'award' },
  { label: 'Projects', id: 'projects', icon: 'grid' },
  { label: 'Experience', id: 'experience', icon: 'briefcase' },
  { label: 'Education', id: 'education', icon: 'book' },
  { label: 'About me', id: 'about', icon: 'user' },
];
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {profile.name}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fc" />
    <meta property="og:title" content={`${title} · ${profile.name}`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
    {siteUrl && <><link rel="canonical" href={siteUrl} /><meta property="og:url" content={siteUrl} /></>}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script is:inline>
      try { const saved = localStorage.getItem('portfolio-theme'); document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="mobile-shade" data-shade></div>
    <aside class="sidebar" id="sidebar" aria-label="Portfolio navigation">
      <a href={withBase('/')} class="brand"><span class="brand-mark">rp<span>.</span></span><span>{profile.name}<span class="brand-caption">PERSONAL PORTFOLIO</span></span></a>
      <div class="sidebar-label">EXPLORE</div>
      <nav>{navigation.map((item) => <a class:list={['nav-link', { active: isHome ? item.id === 'overview' : item.id === 'projects' }]} href={withBase(`/#${item.id}`)} data-nav={item.id} aria-current={(isHome ? item.id === 'overview' : item.id === 'projects') ? 'location' : undefined}><Icon name={item.icon} size={19} />{item.label}{item.id === 'projects' && <span class="nav-count">{String(projects.length).padStart(2, '0')}</span>}</a>)}</nav>
      <div class="sidebar-bottom"><div class="sidebar-note"><Icon name="spark" size={19} /><strong>Always a work in progress.</strong><p>Building, learning, and figuring<br/>things out along the way.</p></div><div class="sidebar-profile"><span class="avatar">{profile.initials}</span><div><strong>{profile.name}</strong><span>A little about my world</span></div><a href={withBase('/#about')} aria-label={`About ${profile.name}`}><Icon name="arrow" size={17} /></a></div></div>
    </aside>
    <div class="workspace">
      <header class="topbar"><div class="breadcrumb"><button class="icon-button menu-button" data-menu aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false"><Icon name="menu" /></button><span class="breadcrumb-root">My portfolio</span><span class="breadcrumb-divider">/</span><span>{title}</span></div><div class="header-actions"><span class="built-with"><span></span> Built with curiosity</span><button class="icon-button" data-theme-toggle aria-label="Switch color theme" aria-pressed="false"><Icon name="sun" class="theme-sun" /><Icon name="moon" class="theme-moon" /></button><a class="header-avatar" href={withBase('/#about')} aria-label={`About ${profile.name}`}>{profile.initials}</a></div></header>
      <main id="main"><slot /></main>
      <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Made with Astro & a little curiosity <Icon name="spark" size={14} /></span><a href={withBase('/#overview')}>Back to top ↑</a></footer>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const syncTheme = () => { const dark = document.documentElement.dataset.theme === 'dark'; toggle?.setAttribute('aria-pressed', String(dark)); toggle?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`); };
      syncTheme();
      toggle?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('portfolio-theme', next); } catch {} syncTheme(); });
      const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
      const sidebar = document.querySelector<HTMLElement>('#sidebar');
      const mobile = matchMedia('(max-width: 800px)');
      const syncSidebar = () => { if (sidebar) sidebar.inert = mobile.matches && !document.body.classList.contains('menu-open'); };
      const closeMenu = () => { document.body.classList.remove('menu-open'); menu?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-label', 'Open navigation'); syncSidebar(); };
      syncSidebar();
      mobile.addEventListener('change', closeMenu);
      menu?.addEventListener('click', () => { const open = document.body.classList.toggle('menu-open'); menu.setAttribute('aria-expanded', String(open)); menu.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation'); syncSidebar(); if (open) sidebar?.querySelector<HTMLElement>('a')?.focus(); });
      document.querySelector('[data-shade]')?.addEventListener('click', closeMenu);
      document.addEventListener('keydown', (event) => {
        if (!document.body.classList.contains('menu-open')) return;
        if (event.key === 'Escape') { closeMenu(); menu?.focus(); }
        if (event.key === 'Tab') {
          const targets = [menu, ...sidebar?.querySelectorAll<HTMLElement>('a, button') || []].filter((target): target is HTMLElement => !!target);
          const index = targets.indexOf(document.activeElement as HTMLElement);
          const next = (index + (event.shiftKey ? -1 : 1) + targets.length) % targets.length;
          event.preventDefault(); targets[next]?.focus();
        }
      });
      sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        const wasOpen = document.body.classList.contains('menu-open'); closeMenu();
        if (wasOpen) { const target = link.hash ? document.getElementById(link.hash.slice(1)) : null; if (target) { target.setAttribute('tabindex', '-1'); target.focus({ preventScroll: true }); } else menu?.focus(); }
      }));
      const sections = [...document.querySelectorAll<HTMLElement>('section[id]')];
      if (sections.length) { const observer = new IntersectionObserver((entries) => { const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top); if (!visible.length) return; document.querySelectorAll('[data-nav]').forEach((link) => { const active = link.getAttribute('data-nav') === visible[0].target.id; link.classList.toggle('active', active); if (active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); }); }, { rootMargin: '-12% 0px -55% 0px', threshold: 0 }); sections.forEach((section) => observer.observe(section)); }
    </script>
  </body>
</html>
