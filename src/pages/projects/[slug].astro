---
import { withBase } from '../../utils/url';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects, type Project } from '../../data/portfolio';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project; }
const { project } = Astro.props;
---
<Layout title={project.title} description={project.description}>
  <div class="detail-page"><a class="text-link back-link" href={withBase('/#projects')}>← Back to all projects</a><div class="eyebrow">{project.category}</div><div class="detail-title"><h1>{project.title}</h1><span class:list={['status', { 'status-active': !project.sample }]}>{project.status}</span></div><p class="detail-introduction">{project.description}</p>{project.sample && <div class="example-banner"><Icon name="spark" size={18} /> This is an example project. Replace this entry with your own work.</div>}<div class="detail-visual"><ProjectVisual variant={project.visual} /></div><div class="detail-grid"><article class="detail-body"><h2>About the project</h2><p>{project.overview}</p><h2>{project.sample ? 'Make this story your own' : 'Highlights'}</h2><ul>{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul></article><aside class="detail-sidebar"><span class="eyebrow">PROJECT DETAILS</span><h3>Built with</h3><div class="tags">{project.technologies.map((technology) => <span>{technology}</span>)}</div><h3>Category</h3><p>{project.category}</p>{project.repositoryUrl && <a class="button button-quiet" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">View source <Icon name="github" size={17} /></a>}{project.demoUrl && <a class="button button-primary" href={project.demoUrl} target="_blank" rel="noopener noreferrer">Live demo <Icon name="external" size={17} /></a>}</aside></div><div class="detail-bottom"><span>There’s always another idea around the corner.</span><a class="button button-quiet" href={withBase('/#projects')}>Explore more projects <Icon name="arrow" size={17} /></a></div></div>
</Layout>
