---
import { withBase } from '../utils/url';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects, experience, education, certifications, certificationLevels, hobbies } from '../data/portfolio';
const sortedCertifications = [...certifications].sort((a, b) =>
  certificationLevels.indexOf(a.level) - certificationLevels.indexOf(b.level) || a.name.localeCompare(b.name, 'en', { numeric: true })
);
const categories = ['All projects', ...new Set(projects.map((project) => project.category))];
---
<Layout>
  <section id="overview" class="overview-section">
    <div class="hero"><div class="hero-copy"><div class="hero-label"><span></span> THE PERSON BEHIND THE PROJECTS</div>
      <div class="hero-identity"><div class="hero-avatar">{profile.photoUrl ? <img src={withBase(profile.photoUrl)} alt={profile.name} width="88" height="88" decoding="async" /> : <span aria-label={`${profile.name} profile avatar`}>{profile.initials}</span>}</div><div><h1>{profile.name}</h1><div class="hero-role">{profile.role}</div>{profile.location && <div class="hero-location"><Icon name="location" size={14} />{profile.location}</div>}</div></div>
      <p>{profile.introduction}</p><div class="hero-actions"><a class="button button-white" href="#projects">Explore my projects <Icon name="arrow" size={17} /></a><a class="hero-secondary" href="#experience">My journey <Icon name="arrow" size={17} /></a></div></div>
      <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="art-spark spark-one">✦</div><div class="art-spark spark-two">+</div><div class="editor-scene"><div class="floating-tag tag-typescript"><Icon name="azure" size={19} /> Azure</div><div class="floating-tag tag-curiosity"><Icon name="csharp" size={21} />.NET Core</div><div class="hero-editor"><div class="editor-header"><div><i></i><i></i><i></i></div><span>AboutMe.cs</span><Icon name="code" size={16} /></div><div class="editor-code"><div><span class="line-number">01</span><code><em>var</em> developer = <em>new</em> {'{'}</code></div><div><span class="line-number">02</span><code>  Name = <b>"{profile.name}"</b>,</code></div><div><span class="line-number">03</span><code>  Mindset = <b>"keep learning"</b>,</code></div><div><span class="line-number">04</span><code>  Ideas = <b>double.PositiveInfinity</b>,</code></div><div><span class="line-number">05</span><code>  Coffee = <b>true</b></code></div><div><span class="line-number">06</span><code>{'};'}</code></div><div class="code-comment"><span class="line-number">07</span><code>// A little better, every day.</code></div></div><div class="editor-footer"><span><span class="green-dot"></span> Always learning</span><span>UTF-8</span></div></div></div></div>
    </div>
    <div class="quick-links"><a href="#projects"><span class="quick-icon purple"><Icon name="grid" /></span><div><strong>Things I’ve built</strong><span>Ideas brought to life</span></div><Icon name="arrow" size={18} /></a><a href="#experience"><span class="quick-icon blue"><Icon name="briefcase" /></span><div><strong>My journey so far</strong><span>Experience & education</span></div><Icon name="arrow" size={18} /></a><a href="#about"><span class="quick-icon coral"><Icon name="compass" /></span><div><strong>Beyond the work</strong><span>The personal side</span></div><Icon name="arrow" size={18} /></a></div>
  </section>
  <section id="certifications"><div class="section-heading"><div><div class="eyebrow">KEEPING THE CURIOSITY ALIVE</div><h2>Azure Certifications</h2><p>Milestones in a continuous learning journey.</p></div><span class="section-icon"><Icon name="award" size={24} /></span></div><div class="certification-grid">{sortedCertifications.map((certification) => <article class="certification-card" data-level={certification.level}><div class="certificate-icon"><Icon name="award" size={22} /></div><div><div class="card-meta"><span>{certification.issuer}</span><span class="certification-level">{certification.level}</span>{certification.sample && <span class="status">Example entry</span>}</div><h3>{certification.name}</h3><p>Issued {certification.date}{certification.expires && ` · Expires ${certification.expires}`}</p>{certification.credentialUrl && <a class="project-link" href={certification.credentialUrl} target="_blank" rel="noopener noreferrer">View credential <Icon name="external" size={14} /></a>}</div></article>)}</div></section>
  <section id="projects"><div class="section-heading"><div><div class="eyebrow">FROM IDEA TO REALITY</div><h2>Selected projects<span class="heading-count">{String(projects.length).padStart(2, '0')}</span></h2><p>A few things I’ve been working on. Each one has a story.</p></div><span class="section-note">Built. Learned. Iterated.</span></div><div class="project-toolbar"><div class="filters" role="group" aria-label="Filter projects">{categories.map((category, index) => <button class:list={['filter-button', { selected: index === 0 }]} data-filter={category} aria-pressed={index === 0}>{category}</button>)}</div><span class="project-result-count" data-result-count aria-live="polite">{projects.length} projects</span></div><div class="projects-grid">{projects.map((project) => <ProjectCard project={project} />)}</div><p class="sample-note"><Icon name="spark" size={14} /> Entries marked “Example” are sample content, ready to be replaced with your own projects.</p></section>
  <section id="experience">
    <div class="section-heading"><div><div class="eyebrow">THE JOURNEY</div><h2>Work experience</h2><p>Where I’ve contributed, collaborated, and grown.</p></div><span class="section-icon"><Icon name="briefcase" size={24} /></span></div>
    <div class="timeline-panel company-timeline">{experience.map((company) => <article class="experience-company">
      <div class="experience-company-heading">
        <div class="company-logo">{company.logoUrl ? <img src={withBase(company.logoUrl)} alt={`${company.organization} logo`} width="48" height="48" loading="lazy" decoding="async" /> : <Icon name="briefcase" size={24} />}</div>
        <div><h3>{company.websiteUrl ? <a href={company.websiteUrl} target="_blank" rel="noopener noreferrer">{company.organization}</a> : company.organization}</h3>{company.period && <span class="experience-meta">{company.period}</span>}{company.location && <span class="experience-meta">{company.location}</span>}</div>
        {company.sample && <span class="status">Example entry</span>}
      </div>
      <ol class:list={['experience-roles', { 'multiple-roles': company.roles.length > 1 }]}>{company.roles.map((item) => <li class="experience-role"><h4>{item.role}</h4>{item.employmentType && <span class="experience-meta">{item.employmentType}</span>}<span class="experience-meta">{item.period}</span>{item.location && <span class="experience-meta">{item.location}</span>}{item.description && <p>{item.description}</p>}</li>)}</ol>
    </article>)}</div>
  </section>
  <section id="education"><div class="section-heading"><div><div class="eyebrow">FOUNDATIONS & NEW PERSPECTIVES</div><h2>Education</h2><p>The learning that shaped the way I think.</p></div><span class="section-icon"><Icon name="book" size={24} /></span></div><div class="timeline-panel">{education.map((item) => <article class="timeline-item"><div class="company-logo">{item.logoUrl ? <img src={withBase(item.logoUrl)} alt={`${item.institution} logo`} width="48" height="48" loading="lazy" decoding="async" /> : <Icon name="book" size={20} />}</div><div class="timeline-content"><div class="timeline-top"><span class="timeline-company">{item.institution}</span>{item.sample && <span class="status">Example entry</span>}</div><h3>{item.qualification}</h3><span class="timeline-date">{item.period}</span><p>{item.description}</p></div></article>)}</div></section>
  <section id="about"><div class="section-heading"><div><div class="eyebrow">A LITTLE MORE HUMAN</div><h2>Beyond the screen</h2><p>There’s more to a person than a list of projects.</p></div></div><div class="about-panel"><div class="about-monogram">{profile.photoUrl ? <img src={withBase(profile.photoUrl)} alt={profile.name} width="480" height="510" loading="lazy" decoding="async" /> : <><span aria-hidden="true">{profile.initials}<i>.</i></span><small aria-hidden="true">HELLO AGAIN</small><div class="monogram-orbit" aria-hidden="true"></div></>}</div><div class="about-copy"><span class="about-label">NICE TO MEET YOU</span><h3>{profile.headline}</h3><p>{profile.about}</p><p>Here you’ll find both the professional side and the personal side: the work, the learning, and the interests that fill the spaces in between.</p><a class="text-link" href="#projects">See what I’m building <Icon name="arrow" size={16} /></a></div></div><div class="hobbies-heading"><h3>Away from the keyboard</h3><span>Sample interests · make these your own</span></div><div class="hobby-grid">{hobbies.map((hobby) => <article class="hobby-card"><span class="hobby-icon"><Icon name={hobby.icon} size={24} /></span><h4>{hobby.name}</h4><p>{hobby.description}</p>{hobby.sample && <span class="hobby-example">Example interest</span>}</article>)}</div>
    <div class="contact-panel"><div><span class="eyebrow">GOOD THINGS START WITH A CONVERSATION</span><h3>Let’s connect.</h3><p>Have an idea, a question, or just want to say hello?</p></div><div class="contact-actions">{profile.email ? <a class="button button-primary" href={`mailto:${profile.email}`}>Say hello <Icon name="mail" size={17} /></a> : <span class="contact-placeholder">Contact details coming soon <Icon name="mail" size={17} /></span>}{profile.githubUrl && <a class="button button-quiet" href={profile.githubUrl} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={15} /></a>}{profile.linkedinUrl && <a class="button button-quiet" href={profile.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="external" size={15} /></a>}</div></div>
  </section>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-project]');
    buttons.forEach((button) => button.addEventListener('click', () => { const category = button.dataset.filter; buttons.forEach((other) => { const selected = other === button; other.classList.toggle('selected', selected); other.setAttribute('aria-pressed', String(selected)); }); let count = 0; cards.forEach((card) => { const visible = category === 'All projects' || card.dataset.category === category; card.hidden = !visible; if (visible) count++; }); const output = document.querySelector('[data-result-count]'); if (output) output.textContent = `${count} ${count === 1 ? 'project' : 'projects'}`; }));
  </script>
</Layout>
